script DewfordBeach_EventScript_FisherBeach {
    // Before the Brawly quest is complete, use the pre-quest teaser text
    if (!flag(FLAG_BRAWLY_QUEST_COMPLETE)) {
        msgbox(DewfordBeach_Text_FisherBeach, MSGBOX_NPC)
        end()
    }
    // All five challenges finished
    if (flag(FLAG_FISHING_CHALLENGE_SHARPEDO_COMPLETE)) {
        msgbox(DewfordBeach_Text_FisherAllChallengesDone, MSGBOX_NPC)
        end()
    }
    // Route to the first uncompleted challenge in sequence
    if (!flag(FLAG_FISHING_CHALLENGE_MAGIKARP_COMPLETE)) {
        goto(DewfordBeach_EventScript_FishingChallenge_Magikarp)
    }
    if (!flag(FLAG_FISHING_CHALLENGE_TENTACOOL_COMPLETE)) {
        goto(DewfordBeach_EventScript_FishingChallenge_Tentacool)
    }
    if (!flag(FLAG_FISHING_CHALLENGE_WAILMER_COMPLETE)) {
        goto(DewfordBeach_EventScript_FishingChallenge_Wailmer)
    }
    if (!flag(FLAG_FISHING_CHALLENGE_STARYU_COMPLETE)) {
        goto(DewfordBeach_EventScript_FishingChallenge_Staryu)
    }
    goto(DewfordBeach_EventScript_FishingChallenge_Sharpedo)
}

// ---- Challenge 1: Magikarp (+1 SD) - reward: 5x Net Ball ----
script DewfordBeach_EventScript_FishingChallenge_Magikarp {
    lock()
    faceplayer()
    msgbox(DewfordBeach_Text_FishingChallenge_Magikarp_Intro, MSGBOX_DEFAULT)
    special(ChoosePartyMon)
    waitstate()
    copyvar(VAR_RESULT, VAR_0x8004)
    if (var(VAR_RESULT) == PARTY_NOTHING_CHOSEN) {
        msgbox(DewfordBeach_Text_FishingChallenge_NothingShown, MSGBOX_DEFAULT)
        release()
        end()
    }
    special(CompareMagikarpFishingSize)
    if (var(VAR_RESULT) == 1) {
        msgbox(DewfordBeach_Text_FishingChallenge_WrongSpecies_Magikarp, MSGBOX_DEFAULT)
        release()
        end()
    }
    if (var(VAR_RESULT) == 2) {
        msgbox(DewfordBeach_Text_FishingChallenge_TooSmall_Magikarp, MSGBOX_DEFAULT)
        release()
        end()
    }
    msgbox(DewfordBeach_Text_FishingChallenge_Success_Magikarp, MSGBOX_DEFAULT)
    giveitem(ITEM_NET_BALL, 5)
    goto_if_eq(VAR_RESULT, FALSE, Common_EventScript_ShowBagIsFull)
    setflag(FLAG_FISHING_CHALLENGE_MAGIKARP_COMPLETE)
    release()
    end()
}

