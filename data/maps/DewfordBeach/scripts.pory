// Admin Double Battle Triggers
script DewfordBeach_EventScript_AdminBattle_NorthernTrigger {
    // If the admins have already been defeated, do nothing
    if (flag(FLAG_BRAWLY_QUEST_ADMINS_DEFEATED)) {
        end
    }
    lock
    // Matt needs to move 1 step east, and Shelly needs to turn right, take 1 step east, then face up
    // Handle Matt's movement
    applymovement(LOCALID_MATT, moves(walk_right))
    // Handle Shelly's movement
    applymovement(LOCALID_SHELLY, moves(face_right, walk_right, face_up))
    waitmovement(0)
    // Check that the player has enough pokemon to battle, then start the battle
    call(DewfordBeach_EventScript_AdminBattle_CheckEnoughMons)
    call(DewfordBeach_EventScript_AdminBattle_DoBattle)
    release
    end
}

script DewfordBeach_EventScript_AdminBattle_SouthernTrigger {
    // If the admins have already been defeated, do nothing
    if (flag(FLAG_BRAWLY_QUEST_ADMINS_DEFEATED)) {
        end
    }
    lock
    //Matt needs to move two steps east, then face down. Shelly needs to face right.
    // Handle Matt's movement
    applymovement(LOCALID_MATT, moves(walk_right*2, face_down))
    // Handle Shelly's movement
    applymovement(LOCALID_SHELLY, moves(face_right))
    waitmovement(0)
    // Check that the player has enough pokemon to battle, then start the battle
    call(DewfordBeach_EventScript_AdminBattle_CheckEnoughMons)
    call(DewfordBeach_EventScript_AdminBattle_DoBattle)
    release
    end
}

script DewfordBeach_EventScript_AdminBattle_CheckEnoughMons {
    // Check that the player has enough pokemon (2+)
    specialvar(VAR_RESULT, CountPartyAliveNonEggMons)
    if (var(VAR_RESULT) < 2) {
        msgbox(DewfordBeach_Text_MattNotEnoughMons, MSGBOX_DEFAULT)
        closemessage()
        fadescreen(FADE_TO_BLACK)
        // Warp the player back to the entrance of the beach
        warp(MAP_DEWFORD_BEACH, 20, 2) # X 20, Y 2
        waitstate()
        release
        end
    }
    // In other case, fall through to the battle
}

script DewfordBeach_EventScript_AdminBattle_DoBattle {
    // Play preamble messages from admins
    msgbox(DewfordBeach_Text_AdminBattlePreamble, MSGBOX_DEFAULT)
    closemessage()

    // Battle the player
    trainerbattle_double(TRAINER_AQUA_ADMINS_BRAWLY_QUEST, DewfordBeach_Text_AdminBattleIntro, DewfordBeach_Text_AdminBattleDefeat, DewfordBeach_Text_MattNotEnoughMons)

    // Trainer won. Play post-battle dialogue, fade to black, remove the Aquas from the beach, then fade back in
    msgbox(DewfordBeach_Text_AdminBattlePostBattle, MSGBOX_DEFAULT)
    closemessage()
    fadescreen(FADE_TO_BLACK)
    removeobject(LOCALID_AQUA_GRUNT_1)
    removeobject(LOCALID_AQUA_GRUNT_2)
    removeobject(LOCALID_AQUA_GRUNT_3)
    removeobject(LOCALID_AQUA_M_NORTH)
    removeobject(LOCALID_AQUA_F_WEST)
    removeobject(LOCALID_MATT)
    removeobject(LOCALID_SHELLY)
    setflag(FLAG_BRAWLY_QUEST_ADMINS_DEFEATED)
    setflag(FLAG_HIDE_BRAWLY_QUEST_AQUAS)
    fadescreen(FADE_FROM_BLACK)
    release
    end
}

text DewfordBeach_Text_AquaGrunt1Intro {
    "TEAM AQUA claimed this beach!"
    "Get out before I make you!"
}

text DewfordBeach_Text_AquaGrunt1Defeat {
    "... Oh. As you were."
}

text DewfordBeach_Text_AquaGrunt1PostBattle {
    "I thought you were one of those"
    "hapless townspeople... You can fight!"
}

text DewfordBeach_Text_AquaGrunt2Intro {
    "Hmph! You've got some nerve"
    "coming here."
    "TEAM AQUA controls this beach!"
    "Turn back now!"
}

text DewfordBeach_Text_AquaGrunt2Defeat {
    "Not bad... for a beginner."
}

text DewfordBeach_Text_AquaGrunt2PostBattle {
    "Hmph! Don't get too full of"
    "yourself! Our Admins won't lose!"
}

text DewfordBeach_Text_AquaGrunt3Intro {
    "Halt! This area is sealed off"
    "under TEAM AQUA's orders!"
}

text DewfordBeach_Text_AquaGrunt3Defeat {
    "What?! How did you beat me?!"
}

text DewfordBeach_Text_AquaGrunt3PostBattle {
    "Fine, go... But our Admins"
    "will stop you!"
}

text DewfordBeach_Text_AquaGruntNorth {
    "TEAM AQUA's got this beach on"
    "lockdown until the bosses say so."
}

text DewfordBeach_Text_AquaGruntWest {
    "I'm doing my part to keep this beach"
    "secure for TEAM AQUA. You aren't"
    "welcome here, so move along!"
}

text DewfordBeach_Text_FisherBeach {
    format("I've been keeping an eye on these waters, and I can tell you've got the look of a real angler. Come find me again soon. I'd like to see what kind of Pokemon you can hook here on DEWFORD BEACH.")
}

text DewfordBeach_Text_FisherBridge {
    format("The fish are really biting today! You can almost feel the rods bending all across DEWFORD BEACH.")
}

text DewfordBeach_Text_BoyByHouse {
    format("Thanks for kicking out those TEAM AQUA grunts! Now I can play in the sand again without getting yelled at!")
}

text DewfordBeach_Text_SwimmerWater {
    format("Ahh, this water is perfect today! Not too cold, not too warm, just right for a long swim.")
}

text DewfordBeach_Text_TuberWater {
    format("Splashy-splash! The water feels like a giant bathtub for the whole beach!")
}

text DewfordBeach_Text_GirlByBrawlyParentsHouse {
    format("Thank you for helping DEWFORD BEACH! If you have a minute, you should visit BRAWLY's parents in the nearby house. They really want to thank you, too.")
}

text DewfordBeach_Text_MattNotEnoughMons {
    format("You're bold enough to challenge us, yet you don't even have enough Pokemon to battle? Come back when you have at least 2!")
}

text DewfordBeach_Text_AdminBattlePreamble {
    "MATT: So, YOU found our hideout, huh?"
    "I was expecting BRAWLY."
    "You don't look like much, but you did"
    "get past our comrades. Impressive."
    "SHELLY: Yeah, not bad. But  we're"
    "a cut above those grunts."
    "Your meddling stops here with us!"
}

text DewfordBeach_Text_AdminBattleIntro {
    "MATT: Let's see if you can back up"
    "your confidence in battle!"
    "SHELLY: Don't hold back, Matt! Let's"
    "show them what TEAM AQUA is made of!"
}

text DewfordBeach_Text_AdminBattleDefeat {
    "MATT: What?! How did you beat us?!"
    "SHELLY: No way... I thought we were"
    "stronger than that!"
}

text DewfordBeach_Text_AdminBattlePostBattle {
    "MATT: I can't believe we lost to you..."
    "SHELLY: Ugh, how embarrassing!"
    "MATT: This place wasn't as hidden"
    "or secure as ARCHIE made it out to be."
    "We'd better get out of here before"
    "more tough trainers slow us down!"
    "SHELLY: Yeah, let's scram!"
}

