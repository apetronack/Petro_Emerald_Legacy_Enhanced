// ---- Fishing challenge texts ----

text DewfordBeach_Text_FisherAllChallengesDone {
    format("You really are the finest angler on\nDEWFORD BEACH!\pI've never seen catches like yours.\nThank you for humoring an old fisherman!")
}

text DewfordBeach_Text_FishingChallenge_NothingShown {
    format("Hm? Nothing to show me?\nCome back when you've got one!")
}

text DewfordBeach_Text_FishingChallenge_Magikarp_Intro {
    format("Glad the beach is open again!\nNow I can get back to business.\pI've spent years looking for a really\nbig MAGIKARP in these waters.\pA great specimen is well above average\nsize - not your everyday catch!\pIf you can show me a big one,\nI'll make it worth your while.")
}

text DewfordBeach_Text_FishingChallenge_WrongSpecies_Magikarp {
    format("Ah, not bad! But that's no MAGIKARP.\nI'm only after the biggest of that kind.")
}

text DewfordBeach_Text_FishingChallenge_TooSmall_Magikarp {
    format("{STR_VAR_2} dm… Not bad, but I've\nseen bigger MAGIKARP than that.\pCatch a larger one and come back!")
}

text DewfordBeach_Text_FishingChallenge_Success_Magikarp {
    format("{STR_VAR_2} dm! Now THAT is a MAGIKARP!\pYou've got a real eye for fishing.\nTake these NET BALLs as my thanks!")
}

text DewfordBeach_Text_FishingChallenge_Tentacool_Intro {
    format("Impressive! That MAGIKARP was a beauty.\pNow I've got another challenge for you.\nCan you find a large TENTACOOL?\pThose jellyfish are tricky to catch, but\na really big one is worth the effort!\pShow me a prize specimen and\nI'll reward you well.")
}

text DewfordBeach_Text_FishingChallenge_WrongSpecies_Tentacool {
    format("Hmm, not what I'm after.\nI want to see a TENTACOOL this time.")
}

text DewfordBeach_Text_FishingChallenge_TooSmall_Tentacool {
    format("{STR_VAR_2} dm… I appreciate the effort,\nbut I've seen bigger TENTACOOL.\pTry again with a larger one!")
}

text DewfordBeach_Text_FishingChallenge_Success_Tentacool {
    format("{STR_VAR_2} dm! What a splendid TENTACOOL!\pEven its tentacles look extra long!\nHere, take this POISON BARB!")
}

text DewfordBeach_Text_FishingChallenge_Wailmer_Intro {
    format("You're on a roll!\pNext up: a big WAILMER.\nThose round fellas can get really huge.\pA large WAILMER is a proper big catch.\nFind one and bring it to show me!")
}

text DewfordBeach_Text_FishingChallenge_WrongSpecies_Wailmer {
    format("That one's not a WAILMER.\nI need to see a nice big one of those!")
}

text DewfordBeach_Text_FishingChallenge_TooSmall_Wailmer {
    format("{STR_VAR_2} dm… That's a fine WAILMER,\nbut not quite big enough for me.\pBring me a larger one!")
}

text DewfordBeach_Text_FishingChallenge_Success_Wailmer {
    format("{STR_VAR_2} dm! What a wondrous WAILMER!\pThat thing is enormous!\nTake this HP UP - you've earned it!")
}

text DewfordBeach_Text_FishingChallenge_Staryu_Intro {
    format("Three for three - you're incredible!\pNow for a tougher one. Can you find\nan unusually large STARYU?\pThese ones are rare. You'll need\nreal luck and skill to catch one.\pIf you manage it, I have a\nvery special reward for you.")
}

text DewfordBeach_Text_FishingChallenge_WrongSpecies_Staryu {
    format("That's not a STARYU.\nI need to see an exceptionally big one!")
}

text DewfordBeach_Text_FishingChallenge_TooSmall_Staryu {
    format("{STR_VAR_2} dm… A good STARYU, but\nI need one truly exceptional in size.\pKeep searching - it's out there!")
}

text DewfordBeach_Text_FishingChallenge_Success_Staryu {
    format("{STR_VAR_2} dm! Incredible!\nThat STARYU is one in a million!\pYou have a gift for this.\nTake this WATER STONE!")
}

text DewfordBeach_Text_FishingChallenge_Sharpedo_Intro {
    format("I can't believe you found that STARYU!\pOne last challenge - and this is\nthe big one. A giant SHARPEDO.\pSHARPEDO are powerful and dangerous,\nand a truly huge one is terrifying.\pBut if anyone can find one,\nit's you. What do you say?")
}

text DewfordBeach_Text_FishingChallenge_WrongSpecies_Sharpedo {
    format("Brave attempt, but that's not\na SHARPEDO. Go find the real thing!")
}

text DewfordBeach_Text_FishingChallenge_TooSmall_Sharpedo {
    format("{STR_VAR_2} dm… Already terrifying,\nbut I need one even more massive.\pThat ultimate trophy is still out there!")
}

text DewfordBeach_Text_FishingChallenge_Success_Sharpedo {
    format("{STR_VAR_2} dm! A colossal SHARPEDO!\pI've fished these waters my whole life\nand never seen anything like it!\pYou are without a doubt the greatest\nangler DEWFORD BEACH has ever known!\pTake this SCOPE LENS as the\nfinal prize of a true champion!")
}

