const LOCALID_AQUA_GRUNT_1        = 2  // Aqua M trainer, north beach (x:19, y:5)
const LOCALID_AQUA_M_NORTH        = 3  // Aqua M non-trainer, north indoor area (x:20, y:13)
const LOCALID_AQUA_F_WEST         = 4  // Aqua F non-trainer, west beach (x:6, y:6)
const LOCALID_MATT                = 5  // Matt, southwest beach (x:2, y:19)
const LOCALID_AQUA_GRUNT_2        = 6  // Aqua F trainer, south beach (x:14, y:18)
const LOCALID_SHELLY              = 17 // Shelly, southwest beach (x:3, y:20)

mapscripts DewfordBeach_MapScripts {}

