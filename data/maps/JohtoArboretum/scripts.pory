    playmoncry(SPECIES_STANTLER, CRY_MODE_NORMAL)
    waitmoncry()
    applymovement(LOCALID_STANTLER, Common_Movement_Delay48)
    waitmovement(0)
    applymovement(LOCALID_STANTLER, moves(
                        face_right,
                        walk_slow_right * 4,
                        walk_slow_up * 4,
                        walk_slow_right * 2,
                        set_invisible
                    )
                )
    waitmovement(0)
    hideobjectat(LOCALID_STANTLER, MAP_JOHTO_ARBORETUM)

    // Norman walks down from (17,3) to (17,12)
    showobjectat(LOCALID_NORMAN, MAP_JOHTO_ARBORETUM)
    applymovement(LOCALID_NORMAN, moves(
                        walk_fast_down * 9,
                        face_right
                    )
                )
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
                    face_left
                    )
                )
    waitmovement(0)
    playse(SE_PIN)
