    waitmovement(0)
    applymovement(LOCALID_NORMAN, Common_Movement_Delay48)
    waitmovement(0)
    msgbox(JohtoArboretum_Text_NormanArboretum, MSGBOX_DEFAULT)
    closemessage()
    applymovement(LOCALID_NORMAN, moves(
                    face_up,
                    walk_fast_up * 9,
                    set_invisible
                    )
                )
    waitmovement(0)
    hideobjectat(LOCALID_NORMAN, MAP_JOHTO_ARBORETUM)
    setvar(VAR_NORMAN_QUEST_STATE, 3)
    releaseall()
}

script JohtoArboretum_EventScript_Ranger1 {
    trainerbattle_double(TRAINER_RANGER_NORMAN_QUEST_4, JohtoArboretum_Text_Ranger1Intro, JohtoArboretum_Text_Ranger1Defeat, JohtoArboretum_Text_NotEnoughMons)
    msgbox(JohtoArboretum_Text_Ranger1PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script JohtoArboretum_EventScript_Ranger2 {
    trainerbattle_single(TRAINER_RANGER_NORMAN_QUEST_5, JohtoArboretum_Text_Ranger2Intro, JohtoArboretum_Text_Ranger2Defeat)
    msgbox(JohtoArboretum_Text_Ranger2PostBattle, MSGBOX_AUTOCLOSE)
    end
}

text JohtoArboretum_Text_Ranger1Intro {
    format("Hey! Who goes there?")
}

text JohtoArboretum_Text_Ranger1Defeat {
    format("Curses!")
}

text JohtoArboretum_Text_NotEnoughMons {
    format("Oh, you don't have enough POKéMON to battle.")
}

text JohtoArboretum_Text_Ranger1PostBattle {
    format("These spooky woods make me a little jumpy.")
}

text JohtoArboretum_Text_Ranger2Intro {
    format("Watch your step!")
}

text JohtoArboretum_Text_Ranger2Defeat {
    format("I'm off balance!")
}

text JohtoArboretum_Text_Ranger2PostBattle {
    format("Maybe YOU should be a SANCTUARY RANGER.")
}

text JohtoArboretum_Text_NormanArboretum {
    format("{PLAYER}! Was that the same STANTLER?\N"
           "...\N"
           "...\N"
           "...\N"
           "It seems like this POKéMON has taken a liking to you. "
           "I've never seen anything like it.\N"
           "Perhaps it senses that you mean it no harm.\N"
           "I'm impressed, {PLAYER}! You really have been coming into your own as a POKéMON TRAINER.\N"
           "It seems like that STANTLER wants you to follow it. I wonder what it has in mind?"
           )
}
