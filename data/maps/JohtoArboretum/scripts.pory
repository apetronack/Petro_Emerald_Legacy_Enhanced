script JohtoArboretum_StantlerAppearance_LowerTrigger {
    lockall
    showobjectat(LOCALID_STANTLER, MAP_JOHTO_ARBORETUM)
    // Stantler: left 2 to x=22, down 4 to y=11, left 4 to (18,11), face down, directly above player at (18,12)
    applymovement(LOCALID_STANTLER, moves(
                        walk_slow_left * 2,
                        walk_slow_down * 4,
                        walk_slow_left * 4,
                        face_down
                    )
                )
    waitmovement(0)
    // Player looks up to face Stantler standing above them
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
                    face_up
                    )
                )
    waitmovement(0)
    applymovement(LOCALID_STANTLER, Common_Movement_Delay48)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_STANTLER, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_STANTLER, Common_Movement_Delay48)
