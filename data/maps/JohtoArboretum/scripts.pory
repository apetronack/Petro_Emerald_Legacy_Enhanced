const LOCALID_NORMAN = 6
const LOCALID_STANTLER = 7

mapscripts JohtoArboretum_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        hideobjectat(LOCALID_NORMAN, MAP_JOHTO_ARBORETUM)
        hideobjectat(LOCALID_STANTLER, MAP_JOHTO_ARBORETUM)
    }
}

script JohtoArboretum_StantlerAppearance_UpperTrigger {
    lockall
    showobjectat(LOCALID_STANTLER, MAP_JOHTO_ARBORETUM)
    // Stantler: left 2 to x=22, down 2 to y=9, left 3 stops at (19,9), adjacent to player at (18,9)
    applymovement(LOCALID_STANTLER, moves(
                        walk_slow_left * 2,
                        walk_slow_down * 2,
                        walk_slow_left * 3
                    )
                )
    waitmovement(0)
    applymovement(LOCALID_STANTLER, Common_Movement_Delay48)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_STANTLER, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_STANTLER, Common_Movement_Delay48)
    waitmovement(0)
    playmoncry(SPECIES_STANTLER, CRY_MODE_NORMAL)
    waitmoncry()
    applymovement(LOCALID_STANTLER, Common_Movement_Delay48)
    waitmovement(0)
    // Stantler retraces its path and disappears
    applymovement(LOCALID_STANTLER, moves(
                        face_right,
                        walk_slow_right * 3,
                        walk_slow_up * 2,
                        walk_slow_right * 2,
                        set_invisible
                    )
                )
    waitmovement(0)
    hideobjectat(LOCALID_STANTLER, MAP_JOHTO_ARBORETUM)

    // Norman walks down from (17,3) to (17,9) to meet the player
    showobjectat(LOCALID_NORMAN, MAP_JOHTO_ARBORETUM)
    applymovement(LOCALID_NORMAN, moves(
                        walk_fast_down * 6,
                        face_right
                    )
                )
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, moves(
                    face_left
                    )
                )
    waitmovement(0)
    playse(SE_PIN)
    applymovement(LOCALID_NORMAN, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(LOCALID_NORMAN, Common_Movement_Delay48)
    waitmovement(0)
    msgbox(JohtoArboretum_Text_NormanArboretum, MSGBOX_DEFAULT)
    closemessage()
    applymovement(LOCALID_NORMAN, moves(
                    face_up,
                    walk_fast_up * 6,
                    set_invisible
                    )
                )
    waitmovement(0)
    hideobjectat(LOCALID_NORMAN, MAP_JOHTO_ARBORETUM)
    setvar(VAR_NORMAN_QUEST_STATE, 3)
    releaseall()
}

