const LOCALID_STANTLER = 1

mapscripts JohtoSanctuary_StantlerClearing_MapScripts {}

script JohtoSanctuary_StantlerClearing_EventScript_StantlerEncounter {
    lock
    if (flag(FLAG_JOHTO_ARBORETUM_STANTLER_GIVEN)) {
        release
        end
    }
    applymovement(LOCALID_STANTLER, moves(
        faceplayer,
        jump_in_place_up_down*2
        )
    )
    waitmovement(0)
    msgbox(JohtoSanctuary_StantlerClearing_ShinyStantler_Text_ShinyGlint)
    closemessage()
    applymovement(LOCALID_STANTLER, moves(
        faceplayer,
        jump_in_place_up_down*2
        )
    )
    waitmovement(0)
    playmoncry(SPECIES_STANTLER, CRY_MODE_ENCOUNTER)
    delay(40)
    waitmoncry()
    special(CreateShinyStantlerEnemy)
    setflag(FLAG_SYS_CTRL_OBJ_DELETE)
    dowildbattle
    clearflag(FLAG_SYS_CTRL_OBJ_DELETE)
    switch (specialvar(VAR_RESULT, GetBattleOutcome)) {
        case B_OUTCOME_WON:
            setflag(FLAG_JOHTO_ARBORETUM_STANTLER_GIVEN)
            setvar(VAR_NORMAN_QUEST_STATE, 4)
            goto(Common_EventScript_RemoveStaticPokemon)
        case B_OUTCOME_CAUGHT:
            setflag(FLAG_JOHTO_ARBORETUM_STANTLER_GIVEN)
            setvar(VAR_NORMAN_QUEST_STATE, 4)
            goto(Common_EventScript_RemoveStaticPokemon)
    }
    release
    end
}

text JohtoSanctuary_StantlerClearing_ShinyStantler_Text_ShinyGlint {
    format("STANTLER: BLEEURGH!")
}