mapscripts JohtoSanctuary_RangerStation_Building3_MapScripts {}

script JohtoSanctuary_RangerStation_Building3_EventScript_Camper1 {
    msgbox(JohtoSanctuaryRangerStationBuilding3_Text_Camper1, MSGBOX_NPC)
    end()
}

script JohtoSanctuary_RangerStation_Building3_EventScript_Camper2 {
    msgbox(JohtoSanctuaryRangerStationBuilding3_Text_Camper2, MSGBOX_NPC)
    end()
}

script JohtoSanctuary_RangerStation_Building3_EventScript_Camper3 {
    msgbox(JohtoSanctuaryRangerStationBuilding3_Text_Camper3, MSGBOX_NPC)
    end()
}

script JohtoSanctuary_RangerStation_Building3_EventScript_Hiker {
    msgbox(JohtoSanctuaryRangerStationBuilding3_Text_Hiker, MSGBOX_NPC)
    end()
}

script JohtoSanctuary_RangerStation_Building3_EventScript_Scientist {
    lock()
    faceplayer()
    // Check if trade has been completed yet
    if (!flag(FLAG_JOHTO_SANCTUARY_RANGER_STATION_NPC_TRADE_2_COMPLETED)) {
        // Trade has not been completed yet, so proceed with trade
        setvar(VAR_0x8008, INGAME_TRADE_CHINCHOU)
        copyvar(VAR_0x8004, VAR_0x8008)
        specialvar(VAR_RESULT, GetInGameTradeSpeciesInfo)
        copyvar(VAR_0x8009, VAR_RESULT)
        msgbox(JohtoSanctuaryRangerStationBuilding3_Text_YouWillTradeWontYou, MSGBOX_YESNO)
        if (var(VAR_RESULT) == NO) {
            goto(JohtoSanctuary_RangerStation_Building3_EventScript_DeclineTrade)
        }
        // Chose to trade
        special(ChoosePartyMon)
        waitstate()
        copyvar(VAR_0x800A, VAR_0x8004)
        if (var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
            goto(JohtoSanctuary_RangerStation_Building3_EventScript_DeclineTrade)
        }
        copyvar(VAR_0x8005, VAR_0x800A)
        specialvar(VAR_RESULT, GetTradeSpecies)
        copyvar(VAR_0x800B, VAR_RESULT)
        if (var(VAR_RESULT) != VAR_0x8009) {
            goto(JohtoSanctuary_RangerStation_Building3_EventScript_NotRequestedMon)
        }
        // Trade is valid, proceed with trade
        copyvar(VAR_0x8004, VAR_0x8008)
        copyvar(VAR_0x8005, VAR_0x800A)
        special(CreateInGameTradePokemon)
        special(DoInGameTradeScene)
        waitstate()
        lock()
        faceplayer()
        bufferspeciesname(STR_VAR_1, VAR_0x8009)
        msgbox(JohtoSanctuaryRangerStationBuilding3_Text_MonYouTakeCare, MSGBOX_DEFAULT)
        closemessage()
        setflag(FLAG_JOHTO_SANCTUARY_RANGER_STATION_NPC_TRADE_2_COMPLETED)
        release()
        end()
    }
    // Trade has already been completed, so just show the post-trade message
    msgbox(JohtoSanctuaryRangerStationBuilding3_Text_PostTradeText, MSGBOX_DEFAULT)
    release()
    end()
}

script JohtoSanctuary_RangerStation_Building3_EventScript_DeclineTrade {
    msgbox(JohtoSanctuaryRangerStationBuilding3_Text_YouWontTradeMe, MSGBOX_DEFAULT)
    release()
    end()
}

script JohtoSanctuary_RangerStation_Building3_EventScript_NotRequestedMon {
    bufferspeciesname(STR_VAR_1, VAR_0x8009)
    msgbox(JohtoSanctuaryRangerStationBuilding3_Text_ThisIsntAMon, MSGBOX_DEFAULT)
    release()
    end()
}

text JohtoSanctuaryRangerStationBuilding3_Text_Camper1 {
    format("I've never seen anything like the JOHTO SANCTUARY before! Norman's been talking about it for ages!")
}

text JohtoSanctuaryRangerStationBuilding3_Text_Camper2 {
    format("It may not seem like a big deal if one POKéMON species goes extinct, but it can have a huge impact on the ecosystem. We have to protect them all!")
}

text JohtoSanctuaryRangerStationBuilding3_Text_Camper3 {
    format("NORMAN knows that even common POKéMON are crucial to keeping our world in balance. He's a great boss!")
}

text JohtoSanctuaryRangerStationBuilding3_Text_Hiker {
    format("Make sure you bring plenty of water and supplies when exploring the JOHTO SANCTUARY!")
}

text JohtoSanctuaryRangerStationBuilding3_Text_YouWillTradeWontYou {
    format("Hi, hi! I am MICHIO! I came to the HOENN region from JOHTO to study deep sea POKéMON, but I care about the conservation of all POKéMON, even the ones on land! Will you trade with me? I have plenty of {STR_VAR_2}, but I've always wanted to find a {STR_VAR_1}!")
}

text JohtoSanctuaryRangerStationBuilding3_Text_ThisIsntAMon {
    format("I'm sorry, but that's not a {STR_VAR_1}. I'm looking for a {STR_VAR_1}.")
}

text JohtoSanctuaryRangerStationBuilding3_Text_YouWontTradeMe {
    format("Darn! Maybe another time then.")
}

text JohtoSanctuaryRangerStationBuilding3_Text_MonYouTakeCare {
    format("I hope you like your new {STR_VAR_2}! They are fascinating POKéMON, if I do say so myself.")
}

text JohtoSanctuaryRangerStationBuilding3_Text_PostTradeText {
    format("People always think we scientists are serious all the time, but we're people with all sorts of interests and passions too! I can't wait to take my SPINDA out for a spin!")
}

