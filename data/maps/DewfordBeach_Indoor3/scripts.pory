// Local IDs for Brawly's parents
const LOCALID_BRAWLY_DAD = 1
const LOCALID_BRAWLY_MOM = 2

mapscripts DewfordBeach_Indoor3_MapScripts {}

// ============================================================
// BRAWLY'S FATHER (OBJ_EVENT_GFX_EXPERT_M)
// Teaches: Body Slam, Rock Slide, Dynamic Punch, Swords Dance,
//          Fire Punch, Ice Punch, Thunder Punch (costs 2 Star Pieces)
// ============================================================

script DewfordBeach_Indoor3_EventScript_BrawlyDad {
    lock()
    faceplayer()
    if (!flag(FLAG_BRAWLY_QUEST_COMPLETE)) {
        msgbox(DewfordBeach_Indoor3_Text_DadPreQuest, MSGBOX_DEFAULT)
        release()
        end()
    }
    msgbox(DewfordBeach_Indoor3_Text_DadGreeting, MSGBOX_DEFAULT)
    goto(DewfordBeach_Indoor3_EventScript_DadMoveTutor)
}

script DewfordBeach_Indoor3_EventScript_DadMoveTutor {
    checkitem(ITEM_STAR_PIECE, 2)
    if (var(VAR_RESULT) == FALSE) {
        checkitem(ITEM_STAR_PIECE)
        if (var(VAR_RESULT) == TRUE) {
            msgbox(DewfordBeach_Indoor3_Text_DadNotEnoughStarPieces, MSGBOX_DEFAULT)
        } else {
            msgbox(DewfordBeach_Indoor3_Text_DadNoStarPiece, MSGBOX_DEFAULT)
        }
        release()
        end()
    }
    message(DewfordBeach_Indoor3_Text_ChooseMove)
    waitmessage()
    multichoice(0, 0, MULTI_BRAWLY_DAD_TUTOR, FALSE)
    switch (var(VAR_RESULT)) {
        case 0: goto(DewfordBeach_Indoor3_EventScript_DadSelectBodySlam)
        case 1: goto(DewfordBeach_Indoor3_EventScript_DadSelectRockSlide)
        case 2: goto(DewfordBeach_Indoor3_EventScript_DadSelectDynamicPunch)
        case 3: goto(DewfordBeach_Indoor3_EventScript_DadSelectSwordsDance)
        case 4: goto(DewfordBeach_Indoor3_EventScript_DadSelectFirePunch)
        case 5: goto(DewfordBeach_Indoor3_EventScript_DadSelectIcePunch)
        case 6: goto(DewfordBeach_Indoor3_EventScript_DadSelectThunderPunch)
        case 7: goto(DewfordBeach_Indoor3_EventScript_TutorCancel)
        case MULTI_B_PRESSED: goto(DewfordBeach_Indoor3_EventScript_TutorCancel)
    }
    goto(DewfordBeach_Indoor3_EventScript_TutorCancel)
}

script DewfordBeach_Indoor3_EventScript_DadSelectBodySlam {
    setvar(VAR_0x8005, TUTOR_MOVE_BODY_SLAM)
    goto(DewfordBeach_Indoor3_EventScript_DadTeachMove)
}

script DewfordBeach_Indoor3_EventScript_DadSelectRockSlide {
    setvar(VAR_0x8005, TUTOR_MOVE_ROCK_SLIDE)
    goto(DewfordBeach_Indoor3_EventScript_DadTeachMove)
}

script DewfordBeach_Indoor3_EventScript_DadSelectDynamicPunch {
    setvar(VAR_0x8005, TUTOR_MOVE_DYNAMIC_PUNCH)
    goto(DewfordBeach_Indoor3_EventScript_DadTeachMove)
}

script DewfordBeach_Indoor3_EventScript_DadSelectSwordsDance {
    setvar(VAR_0x8005, TUTOR_MOVE_SWORDS_DANCE)
    goto(DewfordBeach_Indoor3_EventScript_DadTeachMove)
}

script DewfordBeach_Indoor3_EventScript_DadSelectFirePunch {
    setvar(VAR_0x8005, TUTOR_MOVE_FIRE_PUNCH)
    goto(DewfordBeach_Indoor3_EventScript_DadTeachMove)
}

script DewfordBeach_Indoor3_EventScript_DadSelectIcePunch {
    setvar(VAR_0x8005, TUTOR_MOVE_ICE_PUNCH)
    goto(DewfordBeach_Indoor3_EventScript_DadTeachMove)
}

script DewfordBeach_Indoor3_EventScript_DadSelectThunderPunch {
    setvar(VAR_0x8005, TUTOR_MOVE_THUNDER_PUNCH)
    goto(DewfordBeach_Indoor3_EventScript_DadTeachMove)
}

script DewfordBeach_Indoor3_EventScript_DadTeachMove {
    msgbox(DewfordBeach_Indoor3_Text_TeachToWhichMon, MSGBOX_DEFAULT)
    call(MoveTutor_EventScript_OpenPartyMenu)
    if (var(VAR_RESULT) == 0) {
        goto(DewfordBeach_Indoor3_EventScript_DadMoveTutor)
    }
    removeitem(ITEM_STAR_PIECE, 2)
    msgbox(DewfordBeach_Indoor3_Text_DadThanks, MSGBOX_DEFAULT)
    goto(DewfordBeach_Indoor3_EventScript_DadMoveTutor)
}

// ============================================================
// BRAWLY'S MOTHER (OBJ_EVENT_GFX_EXPERT_F)
// Teaches: Mud Slap, Seismic Toss, Endure,
//          Counter, Mega Punch, Mega Kick (costs 1 Star Piece)
// ============================================================

script DewfordBeach_Indoor3_EventScript_BrawlyMom {
    lock()
    faceplayer()
    if (!flag(FLAG_BRAWLY_QUEST_COMPLETE)) {
