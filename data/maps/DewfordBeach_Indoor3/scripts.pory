script DewfordBeach_Indoor3_EventScript_MomTeachMove {
    msgbox(DewfordBeach_Indoor3_Text_TeachToWhichMon, MSGBOX_DEFAULT)
    call(MoveTutor_EventScript_OpenPartyMenu)
    if (var(VAR_RESULT) == 0) {
        goto(DewfordBeach_Indoor3_EventScript_MomMoveTutor)
    }
    removeitem(ITEM_STAR_PIECE, 1)
    msgbox(DewfordBeach_Indoor3_Text_MomThanks, MSGBOX_DEFAULT)
    goto(DewfordBeach_Indoor3_EventScript_MomMoveTutor)
}

// ============================================================
// SHARED
// ============================================================

script DewfordBeach_Indoor3_EventScript_TutorCancel {
    msgbox(DewfordBeach_Indoor3_Text_TutorCancel, MSGBOX_DEFAULT)
    release()
    end()
}

// ============================================================
// TEXT
// ============================================================

text DewfordBeach_Indoor3_Text_DadPreQuest {
    format("My boy BRAWLY doesn't visit much these days. Always off training. Those rough-looking strangers in town have me a bit uneasy. I hope BRAWLY comes home soon.")
}

text DewfordBeach_Indoor3_Text_DadGreeting {
    format("You're the one who drove out TEAM AQUA? I am very grateful! I taught BRAWLY everything I know. I still remember every move, so it's no trouble at all to teach you, too. These techniques are advanced, so I ask for 2 STAR PIECEs each.")
}

text DewfordBeach_Indoor3_Text_DadNoStarPiece {
    format("You don't have any STAR PIECEs! These techniques aren't for the faint of heart. Come back when you have 2 STAR PIECEs to spare!")
}

text DewfordBeach_Indoor3_Text_DadNotEnoughStarPieces {
    format("You only have 1 STAR PIECE, but my techniques cost 2 each. Any serious fighter knows these moves don't come cheap! Come back when you have 2!")
}

text DewfordBeach_Indoor3_Text_DadThanks {
    format("There you go! I'll take those 2 STAR PIECEs. Tell that BRAWLY to come visit me more often! I hope to see you again soon, {PLAYER}!")
}

text DewfordBeach_Indoor3_Text_MomPreQuest {
    format("Oh, I worry about BRAWLY so. He trains so hard, but never visits. And with those odd people hanging around town lately... I do worry.")
}

text DewfordBeach_Indoor3_Text_MomGreeting {
    format("You helped drive out TEAM AQUA? Oh, what a relief! Thank you! I was quite the TRAINER in my day. I still know all my best moves! I'd be happy to teach your POKéMON. I just ask for a STAR PIECE each time.")
}

text DewfordBeach_Indoor3_Text_MomNoStarPiece {
    format("Oh, you don't have a STAR PIECE? Those are my payment for lessons! They're not easy to find, but trust me, they're worth it. Come back when you have one, dear!")
}

text DewfordBeach_Indoor3_Text_ChooseMove {
    format("Which move would you like to learn?")
}

text DewfordBeach_Indoor3_Text_TeachToWhichMon {
    format("And which POKéMON should learn the move?")
}

text DewfordBeach_Indoor3_Text_MomThanks {
    format("Wonderful! I'll take that STAR PIECE, dear. You remind me of BRAWLY when he was training as a young lad. Come back whenever you'd like to learn more!")
}

text DewfordBeach_Indoor3_Text_TutorCancel {
    format("Come back if you change your mind!")
}
